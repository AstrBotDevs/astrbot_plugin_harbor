{
  "schema_version": 1,
  "id": "astrbot",
  "name": "AstrBot",
  "description": "原生工具与 agent loop · 按 GitHub commit 评测",
  "version": "0.2.0",
  "entrypoint": "astrbot_plugin_harbor.agent:AstrBotAgent",
  "model_required": true,
  "key_env": "ASTRBOT_EVAL_API_KEY",
  "base_env": "ASTRBOT_EVAL_BASE_URL",
  "source": {
    "repository": "https://github.com/AstrBotDevs/AstrBot",
    "ref": "master",
    "argument": "source_dir"
  },
  "capabilities": {
    "phoenix": true,
    "task_mcp": false
  },
  "bundle": "astrbot_plugin_harbor",
  "files": [
    "LICENSE",
    "__init__.py",
    "agent.py",
    "main.py",
    "manifest.py",
    "metadata.yaml",
    "reporting.py",
    "requirements-tracing.txt",
    "run_agent.py",
    "tracing.py"
  ]
}
